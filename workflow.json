{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0",
  "parameters": {
    "gateway": {
      "type": "String",
      "defaultValue": "https://apim-intplat-demo.azure-api.net"
    }
  },
  "triggers": {
    "event": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "method": "POST"
      },
      "description": "One CloudEvent, delivered by the platform's event intake (ADR 0016)."
    }
  },
  "actions": {
    "CloudEvent": {
      "type": "Compose",
      "inputs": "@triggerBody()",
      "runAfter": {}
    },
    "Route": {
      "type": "Switch",
      "expression": "@outputs('CloudEvent')?['type']",
      "runAfter": {
        "CloudEvent": [
          "Succeeded"
        ]
      },
      "cases": {
        "OrderReadyForShipment": {
          "case": "com.acme.order.readyForShipment",
          "actions": {
            "Lines": {
              "type": "Select",
              "inputs": {
                "from": "@outputs('CloudEvent')?['data']?['orderLines']",
                "select": {
                  "productId": "@item()?['productId']",
                  "quantity": "@item()?['quantity']"
                }
              }
            },
            "Shipment_request": {
              "type": "Compose",
              "runAfter": {
                "Lines": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "orderId": "@outputs('CloudEvent')?['data']?['orderId']",
                "customerId": "@outputs('CloudEvent')?['data']?['customerId']",
                "deliveryAddress": "@outputs('CloudEvent')?['data']?['deliveryAddress']",
                "orderLines": "@body('Lines')",
                "requestedDeliveryDate": "@outputs('CloudEvent')?['data']?['requestedDeliveryDate']"
              }
            },
            "Book_shipment": {
              "type": "Http",
              "inputs": {
                "method": "POST",
                "uri": "@{parameters('gateway')}/3pl/shipment-bookings",
                "headers": {
                  "Content-Type": "application/json",
                  "Correlation-Id": "@{outputs('CloudEvent')?['correlationid']}",
                  "traceparent": "@{coalesce(triggerOutputs()?['headers']?['traceparent'], '')}"
                },
                "body": "@if(equals(outputs('Shipment_request')?['requestedDeliveryDate'], null), removeProperty(outputs('Shipment_request'), 'requestedDeliveryDate'), outputs('Shipment_request'))",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "identity": "__IDENTITY__",
                  "audience": "__AUDIENCE__"
                },
                "retryPolicy": {
                  "type": "none"
                }
              },
              "runAfter": {
                "Shipment_request": [
                  "Succeeded"
                ]
              }
            }
          }
        },
        "OrderCancelled": {
          "case": "com.acme.order.cancelled",
          "actions": {
            "Has_shipmentId": {
              "type": "If",
              "runAfter": {},
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@coalesce(outputs('CloudEvent')?['data']?['shipmentId'], '')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Cancel_shipment_booking": {
                  "type": "Http",
                  "inputs": {
                    "method": "DELETE",
                    "uri": "@{parameters('gateway')}/3pl/shipment-bookings/@{encodeUriComponent(outputs('CloudEvent')?['data']?['shipmentId'])}?reason=@{encodeUriComponent(coalesce(outputs('CloudEvent')?['data']?['reason'], 'Order cancelled.'))}",
                    "headers": {
                      "Content-Type": "application/json",
                      "Correlation-Id": "@{outputs('CloudEvent')?['correlationid']}",
                      "traceparent": "@{coalesce(triggerOutputs()?['headers']?['traceparent'], '')}"
                    },
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "identity": "__IDENTITY__",
                      "audience": "__AUDIENCE__"
                    },
                    "retryPolicy": {
                      "type": "none"
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          }
        }
      },
      "default": {
        "actions": {}
      }
    },
    "Handled": {
      "type": "Response",
      "kind": "Http",
      "runAfter": {
        "Route": [
          "Succeeded"
        ]
      },
      "inputs": {
        "statusCode": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "flow": "logistics-intake",
          "event": "@{outputs('CloudEvent')?['type']}",
          "id": "@{outputs('CloudEvent')?['id']}"
        }
      }
    },
    "Failed": {
      "type": "Response",
      "kind": "Http",
      "runAfter": {
        "Route": [
          "Failed",
          "TimedOut"
        ]
      },
      "inputs": {
        "statusCode": 502,
        "headers": {
          "Content-Type": "application/problem+json"
        },
        "body": {
          "type": "https://github.com/azure-intelligence-domain/logistics-intake/blob/main/README.md#when-a-delivery-fails",
          "title": "Delivery Failed",
          "status": 502,
          "detail": "logistics-intake could not hand the event to the 3PL System API; Event Grid retries, then dead-letters.",
          "instance": "@{outputs('CloudEvent')?['id']}"
        }
      }
    }
  },
  "outputs": {}
}